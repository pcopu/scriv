  "steps": [
    {
      "id": "isolate-measurement-output",
      "title": "Verify analysis-copy metadata and public input boundaries",
      "preconditions": [
        "Continuation of source-provenance-recovery using only synthetic Git source, external outputs and trusted pinned Tracer runtime.",
        "The listed commands are the ordered new public subprocess checks in the continuation. Existing 13 importer/isolation checks also run and remain asserted. No native app launches or execution measurements."
      ],
      "actions": [
        "node scripts/prepare-coverage-analysis.mjs --source-manifest ${externalManifest} --source-manifest-sha256 ${digest} --output ${analysisPath}",
        "node scripts/prepare-coverage-analysis.mjs",
        "node scripts/prepare-coverage-analysis.mjs --source-manifest ${externalManifest} --source-manifest-sha256 ${digest}",
        "node scripts/prepare-coverage-analysis.mjs --source-manifest ${externalManifest} --source-manifest-sha256 ${digest} --output",
        "node scripts/prepare-coverage-analysis.mjs --source-manifest ${externalManifest} --source-manifest-sha256 ${digest} --output ${invalidOptionsOutput} --unknown value",
        "node scripts/prepare-coverage-analysis.mjs --source-manifest ${externalManifest} --source-manifest-sha256 ${digest} --output ${invalidOptionsOutput} --output ${invalidOptionsOutput}",
        "node scripts/prepare-coverage-analysis.mjs --source-manifest ${externalManifest} --source-manifest-sha256 ${digest} --source-manifest ${externalManifest} --output ${invalidOptionsOutput}",
        "node scripts/prepare-coverage-analysis.mjs --source-manifest ${externalManifest} --source-manifest-sha256 invalid-digest --output ${invalidDigestOutput}",
        "node scripts/prepare-coverage-analysis.mjs --source-manifest ${externalManifest} --source-manifest-sha256 ${wrongDigest} --output ${invalidDigestOutput}",
        "node scripts/prepare-coverage-analysis.mjs --source-manifest ${externalManifest} --source-manifest-sha256 ${digest} --output ${worldWritableParent}/copy",
        "node scripts/prepare-coverage-analysis.mjs --source-manifest ${malformedManifest} --source-manifest-sha256 ${matchingDigest} --output ${malformedSourceOutput}",
        "node scripts/export-cli-source-manifest.mjs",
        "node scripts/export-cli-source-manifest.mjs --output",
        "node scripts/export-cli-source-manifest.mjs --unknown value",
        "node scripts/export-cli-source-manifest.mjs --output ${invalidExportOutput} --include",
        "node scripts/export-cli-source-manifest.mjs --output ${invalidExportOutput} --include ../outside"
      ],
      "expectations": [

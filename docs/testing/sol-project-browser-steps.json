{
  "version": 1,
  "kind": "scenario-step-catalog",
  "steps": [
    {
      "id": "sol-project-browser-filter-open",
      "title": "Filter local projects and reopen without model changes",
      "preconditions": [
        "Fresh ScrivSession-owned synthetic root only. SCRIV_E2E_APP is an automation-enabled Catalyst bundle. Native execution NOT RUN by author.",
        "Ordered public calls below include existing two-pass search/modal-routing prelude. click(title) performs waitFor(unique enabled/hittable title-or-label) then activate(snapshot path). waitFor performs snapshot reads at 50ms until predicate, 15000ms default. waitForSavedProject reads persisted-projects at 75ms, retrying only exact publication-pending error.",
        "original and created are real persisted-projects observations. Baselines are complete loaded-project objects captured before navigation. No setters, fixtures or filesystem writes outside app-owned fresh root. New project is created through existing browser button.",
        "The post-New-project snapshot may require Close Projects if still mounted, as explicitly recorded. Final close runs on all outcomes."
      ],
      "actions": [
        "ScrivSession.launch(process.env.SCRIV_E2E_APP)",
        "session.waitFor(enabled hittable workspace-project)",
        "session.command(\"activate\", {target:\"workspace-project\"})",
        "session.waitFor(Find a project placeholder)",
        "session.command(\"text\", {target:search.path,text:\"no-such-synthetic-project-7c891\"})",
        "session.waitFor(text === \"No matching projects\")",
        "session.command(\"select\", {target:\"workspace-tabs\",index:1}) [required rejection]",
        "click(\"Clear search\")",
        "session.waitFor(Find a project text === \"\")",
        "click(\"Close Projects\")",
        "session.waitFor(workspace-project enabled/hittable and browser absent)",
        "session.command(\"activate\", {target:\"workspace-project\"})",
        "session.waitFor(Find a project placeholder)",
        "session.command(\"text\", {target:search.path,text:\"no-such-synthetic-project-7c891\"})",
        "session.waitFor(text === \"No matching projects\")",
        "session.command(\"select\", {target:\"workspace-tabs\",index:1}) [required rejection]",
        "click(\"Clear search\")",
        "session.waitFor(Find a project text === \"\")",
        "click(\"Close Projects\")",
        "session.waitFor(workspace-project enabled/hittable and browser absent)",
        "session.command(\"key\", {input:\"s\",modifiers:[\"command\"]})",
        "waitForSavedProject(session, project.title === \"YAM MAN\")",
        "session.command(\"loaded-project\")",
        "session.command(\"activate\", {target:\"workspace-project\"})",
        "click(\"New project\")",
        "waitForSavedProject(session, project.id !== original.id)",
        "session.command(\"snapshot\")",
        "click(\"Close Projects\") [only if browser remains mounted]",
        "session.waitFor(workspace-project title === \"Untitled\")",
        "session.command(\"loaded-project\")",
        "session.command(\"activate\", {target:\"workspace-project\"})",
        "click(\"Scriv Cloud\")",
        "session.waitFor(text === \"Your scriv cloud\")",
        "click(\"Team projects\")",
        "session.waitFor(text === \"Your team projects\")",
        "click(\"On this Mac\")",
        "session.waitFor(hittable Find a project)",
        "session.command(\"text\", {target:search.path,text:\"  yAm mAn  \"})",
        "session.waitFor(selected footer === \"YAM MAN \u00b7 \" + expected.scenes.length + scene pluralization)",
        "click(\"Open project\")",
        "session.waitFor(workspace-project title === \"YAM MAN\" and browser absent)",
        "session.command(\"loaded-project\")",
        "session.command(\"presented-alerts\")",
        "session.command(\"activate\", {target:\"workspace-project\"})",
        "click(\"Recent\")",
        "session.waitFor(hittable Find a project)",
        "session.command(\"text\", {target:search.path,text:\"  uNtItLeD  \"})",
        "session.waitFor(selected footer === \"Untitled \u00b7 \" + expected.scenes.length + scene pluralization)",
        "click(\"Open project\")",
        "session.waitFor(workspace-project title === \"Untitled\" and browser absent)",
        "session.command(\"loaded-project\")",
        "session.command(\"presented-alerts\")",
        "session.command(\"persisted-projects\")",
        "session.close() [finally]"
      ],
      "expectations": [
        {
          "id": "signed-out",
          "description": "Both signed-out source choices show the exact explanatory message, disabled Open project, and visible Sign in to Scriv button.",
          "witness": {
            "path": "tests/e2e/projects.mjs",
            "start": 43,
            "end": 48,
            "sha256": "fc182435e4cfb750e246f5fbea9b7269f2680b88412da4f9e541fc8f19315960"
          }
        },
        {
          "id": "opened",
          "description": "Whitespace-trimmed mixed-case local/recent queries select the expected metadata footer. Opening each project dismisses browser and restores full loaded-project model including exact date bits, with no presented error.",
          "witness": {

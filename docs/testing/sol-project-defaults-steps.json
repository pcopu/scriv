        "key --input s --modifiers command",
        "persisted-projects",
        "snapshot",
        "activate --target workspace-project",
        "activate --title \"New project\"",
        "persisted-projects",
        "snapshot",
        "activate --title \"Close Projects\" if project browser remains open",
        "key --input s --modifiers command",
        "persisted-projects",
        "activate --target workspace-project",
        "text --placeholder \"Find a project\" --text \"YAM MAN\"",
        "activate --title \"Open project\"",
        "loaded-project",
        "presented-alerts",

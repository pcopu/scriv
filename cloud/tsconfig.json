{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext", "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"], "strict": true, "noEmit": true,
    "skipLibCheck": true, "resolveJsonModule": true, "esModuleInterop": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"], "exclude": ["node_modules", "dist", "tests"]
}

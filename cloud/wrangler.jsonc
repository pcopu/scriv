{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scriv-api",
  "account_id": "607b7c9e36c45e8c51e003923d1d0913",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "limits": {"cpu_ms": 30000},
  "observability": {"enabled": true, "head_sampling_rate": 0.1, "redact_query_string": true},
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_URL": "https://scriv-api.muddy-recipe-a722.workers.dev",
    "EMAIL_FROM": "login@scriv.why-not.work",
    "TEAM_PRICE_CENTS": "999",
    "ASSET_MAX_BYTES": "26214400",
    "TEAM_STORAGE_BYTES": "10737418240",
    "SESSION_DAYS": "30"
  },
  "d1_databases": [{"binding":"DB","database_name":"scriv","database_id":"147d5380-0ceb-498f-b763-528f853205a2","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"MEDIA","bucket_name":"scriv-media"}],
  "send_email": [{"name":"EMAIL","allowed_sender_addresses":["login@scriv.why-not.work"]}],
  "durable_objects": {"bindings":[{"name":"PROJECTS","class_name":"ProjectRoom"},{"name":"BILLING","class_name":"BillingCoordinator"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["ProjectRoom","BillingCoordinator"]}],
  "triggers": {"crons":["17 * * * *"]}
}

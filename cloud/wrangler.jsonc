{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scriv-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "limits": {"cpu_ms": 30000},
  "observability": {"enabled": true, "head_sampling_rate": 0.1},
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_URL": "https://scriv-api.YOUR_SUBDOMAIN.workers.dev",
    "TEAM_PRICE_CENTS": "999",
    "ASSET_MAX_BYTES": "26214400",
    "TEAM_STORAGE_BYTES": "10737418240",
    "SESSION_DAYS": "30"
  },
  "d1_databases": [{"binding":"DB","database_name":"scriv","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"MEDIA","bucket_name":"scriv-media"}],
  "durable_objects": {"bindings":[{"name":"PROJECTS","class_name":"ProjectRoom"},{"name":"BILLING","class_name":"BillingCoordinator"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["ProjectRoom","BillingCoordinator"]}],
  "triggers": {"crons":["17 * * * *"]}
}

# Copy to .dev.vars and keep it out of Git. No authentication bypass is provided.
# Email OTP needs a configured EMAIL binding and verified EMAIL_FROM sender; tests fake it.
# The following GitHub values are optional legacy-provider credentials.
ENVIRONMENT=development
PUBLIC_URL=http://localhost:8787
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEAM_PRICE_ID=
# Optional TURN issuer for internet P2P connectivity (Cloudflare Realtime TURN).
TURN_KEY_ID=
TURN_API_TOKEN=

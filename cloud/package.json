{
  "name": "@scriv/cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "node ../scripts/tracer-cli.mjs app -- test services cloud",
    "test:service": "node ../scripts/tracer-cli.mjs app -- test services cloud",
    "db:migrate:local": "wrangler d1 migrations apply scriv --local",
    "db:migrate:remote": "wrangler d1 migrations apply scriv --remote",
    "deploy": "node scripts/preflight.mjs && wrangler deploy",
    "check": "tsc --noEmit",
    "check:config": "node scripts/preflight.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "typescript": "5.9.3",
    "wrangler": "4.155.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.2-beta"
  }
}

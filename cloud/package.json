{
  "name": "@scriv/cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply scriv --local",
    "db:migrate:remote": "wrangler d1 migrations apply scriv --remote",
    "deploy": "node scripts/preflight.mjs && wrangler deploy",
    "check": "tsc --noEmit",
    "test:load": "SCRIV_LOAD_TEST=1 vitest run tests/load.test.ts",
    "check:config": "node scripts/preflight.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.10",
    "@cloudflare/workers-types": "5.20261029.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.155.0"
  }
}

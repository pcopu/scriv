{
  "name": "scriv",
  "version": "0.1.0",
  "private": true,
  "description": "Native script-first Mac filmmaking workspace and Cloudflare collaboration service",
  "scripts": {
    "setup": "npm --prefix cloud ci",
    "check": "npm --prefix cloud run typecheck && node scripts/check-repo.mjs",
    "test": "node scripts/tracer-cli.mjs app -- test tooling",
    "dev:cloud": "npm --prefix cloud run dev",
    "build:mac": "bash scripts/build-catalyst.sh",
    "verify": "bash scripts/verify.sh",
    "test:e2e": "node scripts/tracer-cli.mjs app -- test",
    "test:inventory": "python3 scripts/inventory-cli-migration.py --check",
    "test:services": "node scripts/tracer-cli.mjs app -- test services"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
